# Application Settings
APP_NAME="CView Backend API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (Chạy trực tiếp local hoặc trỏ vào container port 5432)
POSTGRES_USER="cview_user"
POSTGRES_PASSWORD="cview_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5434
POSTGRES_DB="cview_db"
DATABASE_URL="postgresql+psycopg2://cview_user:cview_password@localhost:5434/cview_db"

# JWT & Security Configuration
SECRET_KEY="cview-development-super-secret-key-32-chars-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# File Upload Settings
UPLOAD_DIR="uploads/resumes"
MAX_UPLOAD_SIZE_BYTES=10485760

