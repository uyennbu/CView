# Application Settings
APP_NAME="CView Backend API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (VM3 / Local PostgreSQL)
POSTGRES_USER="cview_user"
POSTGRES_PASSWORD="cview_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="cview_db"
DATABASE_URL="postgresql+psycopg2://cview_user:cview_password@localhost:5432/cview_db"

# JWT & Security Configuration
SECRET_KEY="change-this-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (VM1 Frontend Origin)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# File Upload Settings (Max 10MB as specified in DESIGN.md)
UPLOAD_DIR="uploads/resumes"
MAX_UPLOAD_SIZE_BYTES=10485760

