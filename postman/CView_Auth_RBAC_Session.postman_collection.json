    {
      "name": "5. Quản lý Phiên làm việc & Xoay vòng Token (Session Lifecycle)",
      "description": "Kiểm thử xoay vòng Refresh Token (Token Rotation), chống tấn công dùng lại token cũ (Reuse Detection), và đăng xuất thu hồi phiên.",
      "item": [
        {
          "name": "5.1 Làm mới Access Token (Token Refresh & Rotation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Cấp mới thành công và xoay vòng Refresh Token\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"access_token\");",
                  "    pm.expect(json).to.have.property(\"refresh_token\");",
                  "    pm.environment.set(\"old_candidate_refresh_token\", pm.environment.get(\"candidate_refresh_token\"));",
                  "    pm.environment.set(\"candidate_access_token\", json.access_token);",
                  "    pm.environment.set(\"candidate_refresh_token\", json.refresh_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{candidate_refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "5.2 Tấn công dùng lại Refresh Token cũ sau khi xoay vòng (Kỳ vọng 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Từ chối token đã qua sử dụng\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.detail).to.include(\"không hợp lệ hoặc đã hết hạn\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
