{
  "info": {
    "_postman_id": "cview-auth-rbac-session-suite-v1",
    "name": "CView - Auth, RBAC, Session & Sprint 2 Jobs",
    "description": "Bộ kiểm thử tự động cho Authentication, Granular RBAC, Session Lifecycle và các luồng đăng bài, kiểm duyệt, tìm kiếm việc làm Sprint 2 trên hệ thống CView.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Luồng Ứng viên (Candidate Flow)",
      "description": "Kiểm thử đăng ký từ Navbar, đăng nhập, lấy thông tin tài khoản và kiểm tra vai trò CANDIDATE.",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản Ứng viên mới",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 900000) + 100000;",
                  "pm.environment.set(\"candidate_dynamic_user\", \"cand_\" + rand);",
                  "pm.environment.set(\"candidate_dynamic_email\", \"cand_\" + rand + \"@gmail.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Tạo tài khoản thành công với vai trò CANDIDATE\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"account_id\");",
                  "    pm.expect(json).to.have.property(\"candidate_id\");",
                  "    pm.expect(json.roles).to.include(\"CANDIDATE\");",
                  "    pm.expect(json.status).to.eql(\"ACTIVE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{candidate_dynamic_user}}\",\n  \"email\": \"{{candidate_dynamic_email}}\",\n  \"password\": \"Password@123\",\n  \"full_name\": \"Nguyễn Văn Test\",\n  \"phone_number\": \"0987123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/candidate/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "candidate", "register"]
            }
          }
        },
        {
          "name": "1.2 Đăng ký Ứng viên trùng Email (Kỳ vọng 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Thông báo lỗi rõ ràng về username hoặc email đã tồn tại\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.detail).to.include(\"đã tồn tại\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"candidate01\",\n  \"email\": \"candidate01@gmail.com\",\n  \"password\": \"Password@123\",\n  \"full_name\": \"Nguyễn Trùng Lặp\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/candidate/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "candidate", "register"]
            }
          }
        },
        {
          "name": "1.3 Đăng nhập Ứng viên (Cổng Navbar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Trả về Access Token & Refresh Token hợp lệ\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"access_token\");",
                  "    pm.expect(json).to.have.property(\"refresh_token\");",
                  "    pm.expect(json.token_type.toLowerCase()).to.eql(\"bearer\");",
                  "    pm.expect(json.roles).to.include(\"CANDIDATE\");",
                  "    pm.environment.set(\"candidate_access_token\", json.access_token);",
                  "    pm.environment.set(\"candidate_refresh_token\", json.refresh_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username_or_email\": \"candidate01@gmail.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/candidate/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "candidate", "login"]
            }
          }
        },
        {
          "name": "1.4 Lấy thông tin tài khoản hiện tại (Get Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Hồ sơ người dùng khớp thông tin CANDIDATE\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.roles).to.include(\"CANDIDATE\");",
                  "    pm.expect(json.status).to.eql(\"ACTIVE\");",
                  "    pm.expect(json).to.have.property(\"candidate_id\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidate_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Luồng Nhà tuyển dụng (Recruiter Flow)",
      "description": "Kiểm thử đăng ký từ nút Tuyển dụng (kèm tạo Công ty & Địa chỉ), đăng nhập và gọi API đăng bài của NTD.",
      "item": [
        {
          "name": "2.1 Đăng ký Nhà tuyển dụng & Công ty",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 900000) + 100000;",
                  "pm.environment.set(\"recruiter_dynamic_user\", \"rec_\" + rand);",
                  "pm.environment.set(\"recruiter_dynamic_email\", \"rec_\" + rand + \"@cviewtech.vn\");",
                  "pm.environment.set(\"company_dynamic_name\", \"Doanh nghiệp Số \" + rand);",
                  "pm.environment.set(\"dynamic_tax_code\", \"03\" + String(rand).padStart(8, '0'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Khởi tạo liên kết Công ty và Nhà tuyển dụng thành công\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.roles).to.include(\"RECRUITER\");",
                  "    pm.expect(json).to.have.property(\"recruiter_id\");",
                  "    pm.expect(json).to.have.property(\"company_id\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{recruiter_dynamic_user}}\",\n  \"email\": \"{{recruiter_dynamic_email}}\",\n  \"password\": \"Password@123\",\n  \"full_name\": \"Nguyễn Tuyển Dụng\",\n  \"job_title\": \"Talent Acquisition Lead\",\n  \"work_email\": \"{{recruiter_dynamic_email}}\",\n  \"phone_number\": \"0912345678\",\n  \"company_name\": \"{{company_dynamic_name}}\",\n  \"tax_code\": \"{{dynamic_tax_code}}\",\n  \"industry\": \"Công nghệ Thông tin\",\n  \"street_address\": \"Tòa nhà CView, Q. Cầu Giấy\",\n  \"city\": \"Hà Nội\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/recruiter/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "recruiter", "register"]
            }
          }
        },
        {
          "name": "2.2 Đăng nhập Nhà tuyển dụng (Cổng Tuyển dụng)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Nhận Token mang quyền RECRUITER\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.roles).to.include(\"RECRUITER\");",
                  "    pm.environment.set(\"recruiter_access_token\", json.access_token);",
                  "    pm.environment.set(\"recruiter_refresh_token\", json.refresh_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username_or_email\": \"recruiter01@techcorp.vn\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/recruiter/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "recruiter", "login"]
            }
          }
        },
        {
          "name": "2.3 Nhà tuyển dụng gọi API Đăng bài tuyển dụng (RBAC Success)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.unset(\"created_job_post_id\");",
                  "pm.environment.set(\"job_dynamic_title\", \"Postman - Backend Developer \" + Date.now());",
                  "pm.environment.set(\"job_deadline\", new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Tin tuyển dụng được tạo ở trạng thái chờ kiểm duyệt\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"PENDING\");",
                  "    pm.expect(json.approval_status).to.eql(\"PENDING\");",
                  "});",
                  "pm.test(\"Trả về mã bài đăng để theo dõi và kiểm duyệt\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.job_post_id).to.be.a(\"string\").and.not.empty;",
                  "    pm.environment.set(\"created_job_post_id\", json.job_post_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiter_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{job_dynamic_title}}\",\n  \"position\": \"Backend Developer\",\n  \"job_description\": \"Phát triển và vận hành các dịch vụ backend cho nền tảng CView.\",\n  \"requirements\": \"Có kinh nghiệm phát triển API bằng Python và làm việc với PostgreSQL.\",\n  \"benefits\": \"Môi trường làm việc linh hoạt, có cơ hội phát triển chuyên môn.\",\n  \"job_type\": \"FULL_TIME\",\n  \"workplace_type\": \"HYBRID\",\n  \"city\": \"Hà Nội\",\n  \"salary_min\": 15000000,\n  \"salary_max\": 30000000,\n  \"is_salary_negotiable\": false,\n  \"experience_years_min\": 2,\n  \"required_education\": \"BACHELOR\",\n  \"deadline\": \"{{job_deadline}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs",
              "host": ["{{base_url}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "2.4 Tạo bài đăng riêng để kiểm thử luồng từ chối",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.unset(\"rejected_job_post_id\");",
                  "pm.environment.set(\"rejected_job_title\", \"Postman - Rejection test \" + Date.now());",
                  "pm.environment.set(\"rejected_job_deadline\", new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Lưu mã bài đăng PENDING dành cho kiểm thử từ chối\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.approval_status).to.eql(\"PENDING\");",
                  "    pm.expect(json.job_post_id).to.be.a(\"string\").and.not.empty;",
                  "    pm.environment.set(\"rejected_job_post_id\", json.job_post_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiter_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{rejected_job_title}}\",\n  \"position\": \"Backend Developer\",\n  \"job_description\": \"Phát triển và vận hành các dịch vụ backend cho nền tảng CView.\",\n  \"requirements\": \"Có kinh nghiệm phát triển API bằng Python và làm việc với PostgreSQL.\",\n  \"benefits\": \"Môi trường làm việc linh hoạt, có cơ hội phát triển chuyên môn.\",\n  \"job_type\": \"FULL_TIME\",\n  \"workplace_type\": \"HYBRID\",\n  \"city\": \"Hà Nội\",\n  \"salary_min\": 15000000,\n  \"salary_max\": 30000000,\n  \"is_salary_negotiable\": false,\n  \"experience_years_min\": 2,\n  \"required_education\": \"BACHELOR\",\n  \"deadline\": \"{{rejected_job_deadline}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs",
              "host": ["{{base_url}}"],
              "path": ["jobs"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Luồng Quản trị viên (Admin Flow)",
      "description": "Kiểm thử đăng nhập Admin và gọi API nghiệp vụ kiểm duyệt tin tuyển dụng của Admin.",
      "item": [
        {
          "name": "3.1 Đăng nhập Quản trị viên (Admin Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Nhận Token có vai trò ADMIN\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.roles).to.include(\"ADMIN\");",
                  "    pm.environment.set(\"admin_access_token\", json.access_token);",
                  "    pm.environment.set(\"admin_refresh_token\", json.refresh_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username_or_email\": \"admin.root@cview.vn\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "admin", "login"]
            }
          }
        },
        {
          "name": "3.2 Admin kiểm duyệt phê duyệt tin tuyển dụng (RBAC Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Phê duyệt bài đăng thành APPROVED\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.approval_status).to.eql(\"APPROVED\");",
                  "    pm.expect(json.status).to.eql(\"APPROVED\");",
                  "    pm.expect(json.job_id).to.eql(pm.environment.get(\"created_job_post_id\"));",
                  "    pm.expect(json.moderated_by).to.be.a(\"string\").and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approval_status\": \"APPROVED\",\n  \"rejection_reason\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs/{{created_job_post_id}}/moderation",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{created_job_post_id}}", "moderation"]
            }
          }
        },
        {
          "name": "3.3 Admin từ chối bài đăng và trả về lý do",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Bài đăng chuyển sang REJECTED kèm đúng lý do\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.approval_status).to.eql(\"REJECTED\");",
                  "    pm.expect(json.status).to.eql(\"REJECTED\");",
                  "    pm.expect(json.rejection_reason).to.eql(\"Bài đăng thiếu thông tin về quyền lợi và yêu cầu công việc.\");",
                  "    pm.expect(json.moderated_by).to.be.a(\"string\").and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approval_status\": \"REJECTED\",\n  \"rejection_reason\": \"Bài đăng thiếu thông tin về quyền lợi và yêu cầu công việc.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs/{{rejected_job_post_id}}/moderation",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{rejected_job_post_id}}", "moderation"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Tìm kiếm việc làm theo từ khóa & bộ lọc (Candidate - Sprint 2)",
      "description": "Kiểm thử tìm việc bằng từ khóa, địa điểm, lĩnh vực, hình thức làm việc, mức lương và phân trang; truy vấn được thực hiện với Access Token của ứng viên.",
      "item": [
        {
          "name": "4.1 Tìm kiếm theo từ khóa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Trả về danh sách việc làm và từ khóa đã tìm\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.items).to.be.an(\"array\");",
                  "    pm.expect(json.total).to.be.a(\"number\");",
                  "    pm.expect(json.total).to.be.at.least(json.items.length);",
                  "    pm.expect(json.keyword).to.eql(\"Backend\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidate_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/search?keyword=Backend",
              "host": ["{{base_url}}"],
              "path": ["jobs", "search"],
              "query": [
                {
                  "key": "keyword",
                  "value": "Backend"
                }
              ]
            }
          }
        },
        {
          "name": "4.2 Lọc theo địa điểm và lĩnh vực",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
